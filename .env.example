# ==========================================================================
# Variáveis de ambiente do WPScan Segurança
# Copie este arquivo para ".env.local" (desenvolvimento) ou configure as
# variáveis no painel da Vercel: Project Settings → Environment Variables.
# ==========================================================================

# Chave SECRETA do reCAPTCHA v3 (NUNCA exponha no frontend).
# Já existe um valor padrão no código, mas o recomendado é definir aqui.
RECAPTCHA_SECRET=6LdyGQYtAAAAADCyTaL7vta7-C9ZJdwcmX_bHFre

# (Opcional) Token da API oficial do WPScan (https://wpscan.com/api).
# Se definido, a ferramenta consulta vulnerabilidades reais de plugins/CVE.
# Sem ele, a ferramenta usa verificações próprias + links de consulta manual.
WPSCAN_API_TOKEN=
